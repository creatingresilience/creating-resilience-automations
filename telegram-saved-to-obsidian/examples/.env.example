# Copy this file to ~/.config/telegram-saved-to-obsidian/.env and fill in your values.
# Get them at https://my.telegram.org → "API development tools".
# These are SECRET: never share them and never commit the real .env file.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: default inbox so you don't have to pass --inbox every time.
# OBSIDIAN_INBOX=/path/to/your/vault/Inbox
